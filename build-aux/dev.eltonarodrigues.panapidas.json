{
    "id": "dev.eltonarodrigues.panapidas",
    "runtime": "org.gnome.Sdk",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "command": "panapidas",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland"
    ],
    "modules": [
        "dukpy.json",
        {
            "name": "panapidas",
            "builddir": true,
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "dir",
                    "path": "../"
                }
            ],
            "config-opts": [
                "-Dprofile=development"
            ]
        }
    ]
}