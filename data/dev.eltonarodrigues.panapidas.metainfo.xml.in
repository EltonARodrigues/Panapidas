  <summary>HTTP client API</summary>
  <description>
    <p>
      A HTTP Client for testing APIs written with GTK/LibAdwaita
    </p>
  </description>
  
  <launchable type="desktop-id">@APPID@.desktop</launchable>
  <releases>
  </releases>
  <translation type="gettext">@GETTEXT_PACKAGE@</translation>
