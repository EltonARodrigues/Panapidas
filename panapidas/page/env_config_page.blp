using Gtk 4.0;
using Adw 1;

template $EnvConfigPage: Adw.NavigationPage {
  title: _("env_config");

  child: Adw.ToolbarView content_request {
    [top]
    Adw.HeaderBar {

      SearchEntry search_entry {
        placeholder-text: _("Search Variable");

        search-changed => $on_search_change();
      }

      [end]
      Button save_env_button {
        sensitive: false;
        label: _("Save");

        styles [
          "suggested-action",
        ]

        clicked => $on_env_save();
      }
    }

    content: Adw.Bin {
      ScrolledWindow {
        hscrollbar-policy: never;
        propagate-natural-height: true;
        has-frame: false;
        valign: fill;

        Box {
          orientation: vertical;

          ListBox env_list {
            vexpand: true;

            styles [
              "custom_list"
            ]

            selection-mode: none;
          }

          Adw.StatusPage empty_status_page {
            title: _("Variables not found");
            icon-name: "loupe-minus-symbolic";
            visible: false;
            vexpand: true;
          }
        }
      }
    };
  };
}
