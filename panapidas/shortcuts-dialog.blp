using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: _("General");

    Adw.ShortcutsItem {
      title: _("Show Shortcuts");
      action-name: "app.shortcuts";
    }

    Adw.ShortcutsItem {
      title: _("Quit");
      action-name: "app.quit";
    }
  }

  Adw.ShortcutsSection {
    title: _("Request");

    Adw.ShortcutsItem {
      title: _("Make Request");
      accelerator: "<control>r";
    }

    Adw.ShortcutsItem {
      title: _("Save Request");
      accelerator: "<control>s";
    }
  }
  Adw.ShortcutsSection {
    title: _("Variables");

    Adw.ShortcutsItem {
      title: _("Save Env");
      accelerator: "<control>s";
    }
  }
}