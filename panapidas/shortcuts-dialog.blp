using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: C_("shortcut window", "General");

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Show Shortcuts");
      action-name: "app.shortcuts";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Quit");
      action-name: "app.quit";
    }
  }

  Adw.ShortcutsSection {
    title: C_("shortcut request", "Request");

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Make Request");
      accelerator: "<control>r";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Save Request");
      accelerator: "<control>s";
    }
  }
  Adw.ShortcutsSection {
    title: C_("shortcut window", "Environments");

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Save Env");
      accelerator: "<control>s";
    }
  }
}